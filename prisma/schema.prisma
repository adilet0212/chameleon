// Chameleon — multi-tenant brand platform
//
// Modelling notes:
//   A Tenant is a client brand. Everything a brand owns hangs off it, and every
//   tenant-scoped read is keyed by tenantId first. That single rule is what makes
//   "one codebase, many brands" safe: there is no query path to a row that does
//   not start at a tenant.
//
//   Theme is split from Tenant deliberately. Design tokens change on a different
//   cadence than brand identity (a designer retunes tokens; a brand's name and
//   slug are effectively immutable), and keeping them in their own row means a
//   theme edit never rewrites the tenant record.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  // Compact form for space-constrained chrome (the brand switcher on a phone).
  // Truncating `name` with an ellipsis there looked like a defect; brands know
  // their own short form, so it is data rather than a string operation.
  shortName String
  tagline   String
  about     String
  // Each brand names its catalogue differently — "Menu", "Inventory", "Schedule".
  // Storing the noun keeps the shared components brand-agnostic without a switch
  // statement per tenant in the UI layer.
  itemNoun  String
  itemNounSingular String
  ctaLabel  String
  // The catalogue lives at a different path for each brand — /rook-and-ridge/menu,
  // /northaven/inventory, /foundry/schedule. The URL structure itself is tenant
  // data, resolved per request, not a route hardcoded in the filesystem.
  catalogSlug String
  // Page composition, not just page colour. Selects between the layout arrangements
  // in src/components/layouts — "editorial" | "dense" | "showcase". A brand that
  // only differed by palette would not really be a different brand, so structure is
  // a token like everything else.
  layoutVariant String

  theme     Theme?
  products  Product[]
  pages     Page[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("tenants")
}

model Theme {
  id       String @id @default(cuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Design tokens. These are the only things that vary between brands — the
  // component layer and the spacing/type system are shared and identical.
  primary      String // hex, brand primary
  primaryInk   String // text colour that meets contrast on `primary`
  secondary    String // supporting brand colour, carries large areas
  accent       String // hex, used sparingly — CTAs, prices, active states, eyebrows
  ink          String // primary body text
  inkMuted     String // secondary text

  // Surface family. Three tints derived from the brand rather than from grey, so
  // alternating section backgrounds give a page vertical rhythm instead of one
  // continuous near-white field.
  surface       String // page background
  surfaceRaise  String // card / raised surface
  surfaceAlt    String // alternating band, a step off `surface`
  surfaceSunken String // deeper band, used for dense sections
  surfaceBrand  String // strongest brand tint, for feature bands

  border       String // hairline, tinted toward the brand
  borderStrong String // emphasis border / hover state
  // "r g b" triplet so shadows can be brand-tinted via rgb(var(--t-shadow) / a)
  // instead of defaulting to neutral black.
  shadowRgb    String

  fontDisplay     String // headings
  fontBody        String // body copy
  displayTracking String // letter-spacing for large display type, e.g. "-0.03em"
  radius          String // border radius scale root, e.g. "0.25rem"
  imagery         String // "geometric" | "arc" | "grid" — placeholder art language

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("themes")
}

model Product {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  slug        String
  name        String
  blurb       String
  description String
  category    String
  priceCents  Int
  featured    Boolean @default(false)
  // Separates "exists in the table" from "shown to a visitor". The generated tail
  // has to stay in the table for the index benchmark to mean anything — measuring
  // a lookup against 36 rows would prove nothing — but it should never reach a
  // customer-facing page. Every user-facing query filters on this; the benchmark
  // deliberately does not.
  isCatalogueVisible Boolean @default(false)
  // Deterministic seed for the generated abstract artwork, so a product's
  // visual identity is stable across renders and deploys.
  artSeed     Int

  createdAt DateTime @default(now())

  // The detail-page lookup is `WHERE tenantId = ? AND slug = ?`. This composite
  // unique both enforces "slug is unique within a brand, not globally" and backs
  // that lookup with an index.
  //
  // Benchmarked in scripts/benchmark.ts. Dropping it does not fall back to a
  // sequential scan — the planner uses the (tenantId, category) index below to
  // narrow to one tenant, then filters the remaining ~5,000 rows by slug in the
  // heap. Measured at 18.6x slower on 15k rows even with that fallback available,
  // which is the more honest comparison: the win is skipping the filter, not
  // merely avoiding a table scan.
  @@unique([tenantId, slug])
  // Listing pages read
  // `WHERE tenantId = ? AND isCatalogueVisible ORDER BY featured DESC, createdAt DESC`.
  @@index([tenantId, isCatalogueVisible, featured, createdAt])
  @@index([tenantId, category])
  @@map("products")
}

model Page {
  id       String @id @default(cuid())
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  slug    String
  title   String
  heading String
  body    String

  @@unique([tenantId, slug])
  @@map("pages")
}
