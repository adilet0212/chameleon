# Postgres. Neon, Supabase, or any Postgres 14+.
#
# DATABASE_URL is the pooled connection used by the application at runtime.
# DIRECT_URL is an unpooled connection used for migrations and schema pushes —
# Prisma's DDL does not work through a transaction pooler such as PgBouncer.
# On Neon these are the "Pooled connection" and "Direct connection" strings.

DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"
